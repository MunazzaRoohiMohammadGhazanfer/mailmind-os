{
  "entities": {
    "ScheduledEmail": {
      "title": "ScheduledEmail",
      "description": "An email queued by the Scheduler Agent for future delivery.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "to": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "scheduleTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "sent", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["uid", "to", "subject", "body", "scheduleTime", "status", "createdAt"]
    },
    "VipSender": {
      "title": "VipSender",
      "description": "A VIP sender pinned to the top of the inbox by the VIP Agent.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "senderEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "addedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["uid", "senderEmail", "senderName", "addedAt"]
    },
    "SnoozedEmail": {
      "title": "SnoozedEmail",
      "description": "An email temporarily snoozed by the Snooze Agent.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "emailId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subject": {
          "type": "string",
          "maxLength": 300
        },
        "senderName": {
          "type": "string",
          "maxLength": 120
        },
        "snoozeUntil": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["snoozed", "woken"]
        }
      },
      "required": ["uid", "emailId", "snoozeUntil", "status"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Per-user AI agent toggles, language, and theme preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "darkMode": {
          "type": "boolean"
        },
        "language": {
          "type": "string",
          "enum": ["en", "hi"]
        },
        "agentsEnabled": {
          "type": "object",
          "properties": {}
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["uid", "darkMode", "language", "agentsEnabled"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Workspace team member with Admin or Viewer RBAC role.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["Admin", "Viewer"]
        },
        "addedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["uid", "email", "name", "role", "addedAt"]
    }
  },
  "firestore": {
    "/scheduledEmails/{docId}": {
      "schema": { "$ref": "#/entities/ScheduledEmail" },
      "description": "User-owned scheduled emails"
    },
    "/vipSenders/{docId}": {
      "schema": { "$ref": "#/entities/VipSender" },
      "description": "User-owned VIP senders"
    },
    "/snoozedEmails/{docId}": {
      "schema": { "$ref": "#/entities/SnoozedEmail" },
      "description": "User-owned snoozed emails"
    },
    "/userSettings/{userId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "User preferences and 14 agent ON/OFF states"
    },
    "/teamMembers/{docId}": {
      "schema": { "$ref": "#/entities/TeamMember" },
      "description": "User-managed team members and roles"
    }
  }
}
